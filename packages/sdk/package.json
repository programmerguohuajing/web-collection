{
  "name": "@web-collection/sdk",
  "version": "0.2.3",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "index.d.ts",
    "platform.d.ts",
    "react.d.ts",
    "README.md",
    "README.zh-CN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "main": "dist/web-collection-sdk.iife.js",
  "module": "dist/web-collection-sdk.es.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/web-collection-sdk.es.js",
      "default": "./dist/web-collection-sdk.iife.js"
    },
    "./platform": {
      "types": "./platform.d.ts",
      "import": "./dist/web-collection-sdk.platform.js",
      "require": "./dist/web-collection-sdk.platform.cjs",
      "default": "./dist/web-collection-sdk.platform.js"
    },
    "./miniapp": {
      "types": "./platform.d.ts",
      "import": "./dist/web-collection-sdk.platform.js",
      "require": "./dist/web-collection-sdk.platform.cjs"
    },
    "./uni-app": {
      "types": "./platform.d.ts",
      "import": "./dist/web-collection-sdk.platform.js",
      "require": "./dist/web-collection-sdk.platform.cjs"
    },
    "./taro": {
      "types": "./platform.d.ts",
      "import": "./dist/web-collection-sdk.platform.js",
      "require": "./dist/web-collection-sdk.platform.cjs"
    },
    "./react-native": {
      "types": "./platform.d.ts",
      "import": "./dist/web-collection-sdk.platform.js",
      "require": "./dist/web-collection-sdk.platform.cjs"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./dist/web-collection-sdk.react.js",
      "require": "./dist/web-collection-sdk.react.cjs",
      "default": "./dist/web-collection-sdk.react.js"
    }
  },
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.js && vite build --config vite.platform.config.js && vite build --config vite.react.config.js",
    "test": "node --test test/event.test.js && node test/platform.test.js && node test/performance.test.js && node test/console.test.js && node test/click.test.js && node test/error.test.js && node --test test/fetch.test.js && node --test test/trace.test.js && node --test test/exporter.test.js && node --test test/propagation.test.js && node --test test/privacy.test.js && node --test test/sampling.test.js && node --test test/transport.test.js && node --test test/replay.test.js && node --test test/capabilities-identity.test.js && node --test test/init-smoke.test.js"
  },
  "devDependencies": {
    "rrweb": "2.1.0",
    "terser": "^5.49.0",
    "typescript": "^7.0.2",
    "vite": "^6.3.5"
  }
}
