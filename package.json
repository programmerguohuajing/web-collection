{
  "name": "web-collection",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @web-collection/api dev",
    "dev:web": "pnpm --filter @web-collection/web dev",
    "build": "pnpm --filter @web-collection/web build && pnpm --filter @web-collection/sdk build && node scripts/pack-dist.js",
    "build:cloudflare": "pnpm --filter @web-collection/web build && pnpm --filter @web-collection/sdk build && node scripts/prepare-cloudflare.js",
    "sourcemaps:upload": "node scripts/upload-sourcemaps.js",
    "test:release-gate": "node scripts/release-gate.mjs",
    "start": "pnpm --filter @web-collection/api start",
    "test": "pnpm --filter @web-collection/api test",
    "bench:api": "node scripts/benchmark-queries.mjs",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@upstash/qstash": "^2.8.4"
  },
  "devDependencies": {
    "source-map-js": "1.2.1",
    "wrangler": "4.106.0"
  }
}
