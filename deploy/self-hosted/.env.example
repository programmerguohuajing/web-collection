# ============================================
# D4 白标 · 私有化自托管环境变量样例
# 复制为仓库根目录 .env 后填写：cp .env.example .env
# 品牌出厂预置：改下方 BRAND_* 即启动即生效（无需进系统）；
#   界面保存值 > env BRAND_* > 内置默认（Web Collection / #4f46e5）。
# ============================================

# -------------------- 服务端口 --------------------
PORT=8787

# -------------------- 数据库 (PostgreSQL) --------------------
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/web_eys

# -------------------- 安全 --------------------
ADMIN_API_KEY=change-me-in-prod
COLLECT_TOKEN=

# -------------------- 跨域 --------------------
CORS_ORIGIN=*

# -------------------- 事件存储上限 --------------------
MAX_EVENTS=50000

# -------------------- 前端静态文件 --------------------
WEB_DIST=../web/dist
SDK_DIST=../../packages/sdk/dist

# ============================================
# 白标 / 私有化（PRD 16）—— 出厂预置（可选）
# 留空则回落到内置默认；界面保存后以界面值为准。
# ============================================

# 品牌名（侧栏 / 页头 / 浏览器标题 / 告警默认标题）
BRAND_NAME=Web Collection
# 侧栏缩写（无 Logo 时展示的方块文字，≤8 字符）
BRAND_SHORT_NAME=WC
# Logo 图片 URL（https:// 或 / 开头相对路径；留空走缩写方块）
BRAND_LOGO_URL=
# favicon URL（留空用 /favicon.svg）
BRAND_FAVICON_URL=
# 主色（须 6 位 hex）
BRAND_PRIMARY_COLOR=#4f46e5
# 登录页主标题（留空回落品牌名）
BRAND_LOGIN_TITLE=
# 登录页副标题
BRAND_LOGIN_SUBTITLE=前端遥测平台

# 控制台对外域名（仅文档/接入片段生成用，不改 CORS_ORIGIN 语义；
# 反代与证书由部署侧完成）
PUBLIC_CONSOLE_ORIGIN=
